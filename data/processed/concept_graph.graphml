    </edge>
    <edge source="pointer-arithmetic" target="pointer-to-array">
      <data key="d4">prerequisite</data>
      <data key="d5">3.0</data>
      <data key="d6">array access is pointer arithmetic</data>
    </edge>
    <edge source="abstract-data-type" target="static-array">
      <data key="d4">prerequisite</data>
      <data key="d5">2.0</data>
      <data key="d6">the array is the first concrete structure</data>
    </edge>
    <edge source="static-array" target="singly-linked-list">
