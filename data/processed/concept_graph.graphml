      <data key="d6">a string is an array of characters</data>
    </edge>
    <edge source="array" target="static-array">
      <data key="d4">prerequisite</data>
      <data key="d5">3.0</data>
      <data key="d6">the C array is the structure studied here</data>
    </edge>
    <edge source="array-indexing" target="multidimensional-array">
      <data key="d4">prerequisite</data>
      <data key="d5">3.0</data>
      <data key="d6">two indices instead of one</data>
    </edge>
    <edge source="c-string" target="string-function">
